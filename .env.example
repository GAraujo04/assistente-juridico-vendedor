# Copie este arquivo para ".env" e preencha com sua chave.
# NÃO coloque a chave dentro do código (app.py) — ela deve ficar só aqui.

# --- Provedor padrão: Groq (grátis) ---------------------------------------
# Obtenha uma chave em https://console.groq.com/keys (formato gsk_...).
OPENAI_API_KEY=gsk_sua-chave-groq-aqui
OPENAI_MODEL=llama-3.3-70b-versatile

# --- Trocar de provedor (opcional) -----------------------------------------
# O app usa o client da OpenAI apontando para LLM_BASE_URL (padrão: Groq).
# Para usar outro provedor compatível com a API da OpenAI, defina:
#   LLM_BASE_URL=https://outro-provedor.example/v1
#   OPENAI_API_KEY=<chave desse provedor>
#   OPENAI_MODEL=<nome do modelo desse provedor>
#
# Ex.: GitHub Models (github.com/marketplace/models) usa um token pessoal do
# GitHub como chave — confira a documentação atual deles para o base_url e
# nome de modelo corretos antes de trocar.
# LLM_BASE_URL=https://models.github.ai/inference
